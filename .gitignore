# Topology: ephemeral working state lives under .scratch/; durable agent history
# (the flight-recorder subrepo) lives under .ledger/. Both are gitignored so
# the parent repo does not track transient artifacts or subrepo internals.
.scratch/
.ledger/

# Unrelated tooling and caches.
.antigravitycli/
.prior_art_cache/
__pycache__/
.grepai
